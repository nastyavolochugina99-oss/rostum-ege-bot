# Токен бота от @BotFather
BOT_TOKEN=your_bot_token_here

# Ссылка на куратора: при нажатии «Написать куратору» откроется этот чат (например https://t.me/username)
# CURATOR_LINK=https://t.me/username

# Админы: только эти user_id видят команду /записи (список записей). Узнать свой ID: напиши боту @userinfobot в Telegram
# ADMIN_IDS=123456789

# Старт первой сессионной недели (14-дневный цикл): YYYY-MM-DD
# По умолчанию: 2026-03-02
# COURSE_CYCLE_START_DATE=2026-03-02
