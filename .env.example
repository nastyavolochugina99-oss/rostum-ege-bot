# Токен бота от @BotFather
BOT_TOKEN=your_bot_token_here

# Ссылка на куратора: при нажатии «Написать куратору» откроется этот чат (например https://t.me/username)
# CURATOR_LINK=https://t.me/username

# Опционально: Telegram user_id админов через запятую (для будущих админ-команд)
# ADMIN_IDS=123456789,987654321
